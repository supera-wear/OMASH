<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/cie_shield_app_icon"
        android:roundIcon="@drawable/cie_shield_app_icon"
        android:label="CIE Shield"
        android:supportsRtl="true"
        android:theme="@style/Theme.CIE"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MessageShieldLabActivity"
            android:exported="false"
            android:label="CIE Shield Lab" />

        <activity android:name=".MainActivity" android:exported="false" />

        <activity
            android:name=".MainActivity076"
            android:exported="true"
            android:label="CIE Shield">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".telecom.CieCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>
    </application>
</manifest>
