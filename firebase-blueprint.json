{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information, contact details, and BIT Points.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "points": { "type": "number", "description": "BIT Points accumulated" }
      },
      "required": ["uid", "email"]
    },
    "Order": {
      "title": "Order",
      "description": "Stores customer order details.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array", "description": "List of items in the order" },
        "totalPrice": { "type": "number" },
        "pointsEarned": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["pending", "completed", "cancelled"] }
      },
      "required": ["userId", "items", "totalPrice", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile documents"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders"
    }
  }
}
